# ===== photo-clinic v0.1.2 配置示例 =====
# LLM provider 配置
# openai_compat（默认，通义/DeepSeek/智谱/豆包通用）| anthropic（可选）
PHOTO_AGENT_PROVIDER=openai_compat

# 阿里云百炼 OpenAI 兼容端点
PHOTO_AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 百炼 API Key（dashscope 控制台获取）
PHOTO_AGENT_API_KEY=
# 模型 ID 以百炼控制台实际模型为准（示例；皮肤质感/肤色判断建议用 qwen-vl-max）
PHOTO_AGENT_MODEL=qwen-vl-max

# ===== 可选 =====
# 图片大小上限（MB），默认 10；超过会自动压缩（5 倍为硬上限，超过返回 413）；
# 送 LLM 评审的图统一压到长边 ≤3000px、≤2MB（元数据检测后，不影响 AI 证据判定）
# PHOTO_AGENT_MAX_IMAGE_MB=10
# 同时在途的评审请求上限，默认 4（排队请求不解析请求体，防内存峰值）
# PHOTO_AGENT_MAX_CONCURRENT_REVIEWS=4
# skills 目录（默认自动定位到仓库根 .claude/skills）
# PHOTO_AGENT_SKILLS_DIR=
# 服务访问密钥：设置后 /api/review 要求请求头 X-API-Key（内测/公开部署必设；未设置 = 无鉴权，仅限本地开发）
# PHOTO_AGENT_ACCESS_KEY=
# CORS 允许的来源，逗号分隔（浏览器前端调用时才需要；空 = 不加 CORS）
# PHOTO_AGENT_ALLOWED_ORIGINS=https://example.com

# ===== 使用 Claude 时 =====
# PHOTO_AGENT_PROVIDER=anthropic
# PHOTO_AGENT_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=
